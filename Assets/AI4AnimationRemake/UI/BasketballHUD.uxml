<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/AI4AnimationRemake/UI/BasketballHUD.uss?fileID=7433441132597879392&amp;guid=2aa649a13df3fc44b8ae466ba0ffa0f0&amp;type=3#BasketballHUD" />
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
        <ui:VisualElement name="debug-hud" class="hud-layer" picking-mode="Ignore">
        <ui:VisualElement class="top-shell">
            <ui:VisualElement class="toolbar">
                <ui:Button name="hud-toggle" text="HUD" class="toolbar-button is-active" />
                <ui:Button name="debug-toggle" text="DEBUG" class="toolbar-button is-active" />
                <ui:VisualElement class="mode-pill" picking-mode="Ignore">
                    <ui:Label name="mode-label" text="P1 / TEAM A" class="mode-label" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="telemetry-card" class="glass-card telemetry-card" picking-mode="Ignore">
            <ui:VisualElement class="card-heading" picking-mode="Ignore">
                <ui:VisualElement picking-mode="Ignore">
                    <ui:Label text="NEURAL STATE" class="eyebrow" />
                    <ui:Label name="ball-state" text="CONTROLLED" class="card-title" />
                </ui:VisualElement>
                <ui:Label name="tick-label" text="TICK 000000" class="mono-label" />
            </ui:VisualElement>
            <ui:Label text="STYLE" class="section-label" />
            <ui:VisualElement class="metric-row"><ui:Label text="STAND" class="metric-name" /><ui:VisualElement class="metric-track"><ui:VisualElement name="style-0" class="metric-fill style-fill" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="metric-row"><ui:Label text="MOVE" class="metric-name" /><ui:VisualElement class="metric-track"><ui:VisualElement name="style-1" class="metric-fill style-fill" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="metric-row"><ui:Label text="DRIBBLE" class="metric-name" /><ui:VisualElement class="metric-track"><ui:VisualElement name="style-2" class="metric-fill style-fill" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="metric-row"><ui:Label text="HOLD" class="metric-name" /><ui:VisualElement class="metric-track"><ui:VisualElement name="style-3" class="metric-fill style-fill" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="metric-row"><ui:Label text="SHOOT" class="metric-name" /><ui:VisualElement class="metric-track"><ui:VisualElement name="style-4" class="metric-fill style-fill" /></ui:VisualElement></ui:VisualElement>
            <ui:Label text="CONTACT" class="section-label contact-section" />
            <ui:VisualElement class="metric-row compact"><ui:Label text="L FOOT" class="metric-name" /><ui:VisualElement class="metric-track"><ui:VisualElement name="contact-0" class="metric-fill contact-fill" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="metric-row compact"><ui:Label text="R FOOT" class="metric-name" /><ui:VisualElement class="metric-track"><ui:VisualElement name="contact-1" class="metric-fill contact-fill" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="metric-row compact"><ui:Label text="L HAND" class="metric-name" /><ui:VisualElement class="metric-track"><ui:VisualElement name="contact-2" class="metric-fill contact-fill" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="metric-row compact"><ui:Label text="R HAND" class="metric-name" /><ui:VisualElement class="metric-track"><ui:VisualElement name="contact-3" class="metric-fill contact-fill" /></ui:VisualElement></ui:VisualElement>
            <ui:VisualElement class="metric-row compact"><ui:Label text="BALL" class="metric-name" /><ui:VisualElement class="metric-track"><ui:VisualElement name="contact-4" class="metric-fill contact-fill" /></ui:VisualElement></ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="performance-card" class="glass-card performance-card" picking-mode="Ignore">
            <ui:VisualElement class="performance-heading" picking-mode="Ignore">
                <ui:VisualElement picking-mode="Ignore">
                    <ui:Label text="PERFORMANCE" class="eyebrow" />
                    <ui:Label text="RUNTIME METRICS" class="card-title performance-title" />
                </ui:VisualElement>
                <ui:Label name="backend-label" text="SENTIS GPU INITIALIZING" class="mono-label" />
            </ui:VisualElement>
            <ui:VisualElement class="performance-row"><ui:Label text="FPS" class="performance-name" /><ui:Label name="fps-label" text="--" class="performance-value performance-primary" /></ui:VisualElement>
            <ui:VisualElement class="performance-row"><ui:Label text="FRAME" class="performance-name" /><ui:Label name="frame-time-label" text="--" class="performance-value" /></ui:VisualElement>
            <ui:VisualElement class="performance-row"><ui:Label text="MAIN CPU" class="performance-name" /><ui:Label name="main-thread-label" text="--" class="performance-value" /></ui:VisualElement>
            <ui:VisualElement class="performance-row"><ui:Label text="GPU" class="performance-name" /><ui:Label name="gpu-time-label" text="--" class="performance-value" /></ui:VisualElement>
            <ui:VisualElement class="performance-row"><ui:Label text="GC / FRAME" class="performance-name" /><ui:Label name="gc-label" text="--" class="performance-value" /></ui:VisualElement>
            <ui:VisualElement class="performance-row"><ui:Label text="INFERENCE" class="performance-name" /><ui:Label name="inference-label" text="--" class="performance-value" /></ui:VisualElement>
            <ui:VisualElement class="performance-row"><ui:Label text="GPU INFER RTT" class="performance-name" /><ui:Label name="sentis-latency-label" text="--" class="performance-value" /></ui:VisualElement>
            <ui:VisualElement class="performance-row"><ui:Label text="NEURAL PIPE" class="performance-name" /><ui:Label name="neural-pipeline-label" text="--" class="performance-value" /></ui:VisualElement>
            <ui:VisualElement class="performance-row"><ui:Label text="ANIMATION" class="performance-name" /><ui:Label name="animation-label" text="--" class="performance-value" /></ui:VisualElement>
            <ui:VisualElement class="performance-row"><ui:Label text="CAMERA SCRIPT" class="performance-name" /><ui:Label name="camera-cpu-label" text="--" class="performance-value" /></ui:VisualElement>
            <ui:VisualElement class="performance-row"><ui:Label text="NEURAL RATE" class="performance-name" /><ui:Label name="neural-rate-label" text="WARMUP" class="performance-value performance-accent" /></ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="expert-card" class="glass-card expert-card" picking-mode="Ignore">
            <ui:VisualElement class="expert-heading" picking-mode="Ignore">
                <ui:Label text="MIXTURE OF EXPERTS" class="eyebrow" />
                <ui:Label text="GATING WEIGHTS" class="mono-label" />
            </ui:VisualElement>
            <ui:VisualElement class="expert-grid" picking-mode="Ignore">
                <ui:VisualElement class="expert-column"><ui:VisualElement class="expert-track"><ui:VisualElement name="expert-0" class="expert-fill expert-0" /></ui:VisualElement><ui:Label text="01" class="expert-label" /></ui:VisualElement>
                <ui:VisualElement class="expert-column"><ui:VisualElement class="expert-track"><ui:VisualElement name="expert-1" class="expert-fill expert-1" /></ui:VisualElement><ui:Label text="02" class="expert-label" /></ui:VisualElement>
                <ui:VisualElement class="expert-column"><ui:VisualElement class="expert-track"><ui:VisualElement name="expert-2" class="expert-fill expert-2" /></ui:VisualElement><ui:Label text="03" class="expert-label" /></ui:VisualElement>
                <ui:VisualElement class="expert-column"><ui:VisualElement class="expert-track"><ui:VisualElement name="expert-3" class="expert-fill expert-3" /></ui:VisualElement><ui:Label text="04" class="expert-label" /></ui:VisualElement>
                <ui:VisualElement class="expert-column"><ui:VisualElement class="expert-track"><ui:VisualElement name="expert-4" class="expert-fill expert-4" /></ui:VisualElement><ui:Label text="05" class="expert-label" /></ui:VisualElement>
                <ui:VisualElement class="expert-column"><ui:VisualElement class="expert-track"><ui:VisualElement name="expert-5" class="expert-fill expert-5" /></ui:VisualElement><ui:Label text="06" class="expert-label" /></ui:VisualElement>
                <ui:VisualElement class="expert-column"><ui:VisualElement class="expert-track"><ui:VisualElement name="expert-6" class="expert-fill expert-6" /></ui:VisualElement><ui:Label text="07" class="expert-label" /></ui:VisualElement>
                <ui:VisualElement class="expert-column"><ui:VisualElement class="expert-track"><ui:VisualElement name="expert-7" class="expert-fill expert-7" /></ui:VisualElement><ui:Label text="08" class="expert-label" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="control-card" class="glass-card control-card" picking-mode="Ignore">
            <ui:VisualElement class="control-heading" picking-mode="Ignore">
                <ui:VisualElement picking-mode="Ignore">
                    <ui:Label text="DRIBBLE CONTROL" class="eyebrow" />
                    <ui:Label text="BALL TARGET" class="card-title" />
                </ui:VisualElement>
                <ui:Label name="control-state" text="IDLE" class="control-state" />
            </ui:VisualElement>
            <ui:VisualElement name="control-disk" class="control-disk" picking-mode="Ignore" />
            <ui:VisualElement class="disk-legend" picking-mode="Ignore">
                <ui:VisualElement class="legend-item"><ui:VisualElement class="legend-dot target-dot" /><ui:Label text="INPUT" /></ui:VisualElement>
                <ui:VisualElement class="legend-item"><ui:VisualElement class="legend-dot pivot-dot" /><ui:Label text="PIVOT" /></ui:VisualElement>
                <ui:VisualElement class="legend-item"><ui:VisualElement class="legend-dot momentum-dot" /><ui:Label text="MOMENTUM" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="gameplay-hud" class="hud-layer" picking-mode="Ignore">
            <ui:VisualElement class="gameplay-status glass-card" picking-mode="Ignore">
                <ui:Label text="GAMEPLAY" class="eyebrow" />
                <ui:Label name="gameplay-mode-label" text="P1 / TEAM A" class="gameplay-status-label" />
            </ui:VisualElement>
            <ui:VisualElement class="help-card glass-card" picking-mode="Ignore">
                <ui:VisualElement class="help-heading" picking-mode="Ignore">
                    <ui:VisualElement picking-mode="Ignore">
                        <ui:Label text="KEYBOARD + MOUSE" class="eyebrow" />
                        <ui:Label text="操作提示" class="help-title" />
                    </ui:VisualElement>
                    <ui:Label text="U  DEBUG HUD" class="mono-label" />
                </ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:VisualElement class="key-group"><ui:Label text="WASD" class="keycap keycap-wide" /></ui:VisualElement><ui:Label text="移動、側移與後退" class="help-action" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:VisualElement class="key-group"><ui:Label text="SHIFT" class="keycap keycap-wide" /></ui:VisualElement><ui:Label text="衝刺並轉向移動方向" class="help-action" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:VisualElement class="key-group"><ui:Label text="SPACE" class="keycap keycap-wide" /></ui:VisualElement><ui:Label text="投籃" class="help-action" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:VisualElement class="key-group"><ui:Label text="CTRL" class="keycap" /><ui:Label text="+" class="key-plus" /><ui:Label text="LMB" class="keycap" /></ui:VisualElement><ui:Label text="有球時鎖定並傳球" class="help-action" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:VisualElement class="key-group"><ui:Label text="CTRL" class="keycap keycap-wide" /></ui:VisualElement><ui:Label text="無球呼叫傳球；Loose Ball 時撿球" class="help-action" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:VisualElement class="key-group"><ui:Label text="LMB" class="keycap keycap-wide" /></ui:VisualElement><ui:Label text="近距離嘗試拍球" class="help-action" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:VisualElement class="key-group"><ui:Label text="TAB" class="keycap keycap-wide" /></ui:VisualElement><ui:Label text="切換操控球員" class="help-action" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:VisualElement class="key-group"><ui:Label text="RMB" class="keycap keycap-wide" /></ui:VisualElement><ui:Label text="持球位置控制" class="help-action" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:VisualElement class="key-group"><ui:Label text="P" class="keycap keycap-single" /></ui:VisualElement><ui:Label text="自由攝影機；全部球員交由 AI" class="help-action" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="freecam-hud" class="hud-layer" picking-mode="Ignore">
            <ui:VisualElement class="freecam-badge glass-card" picking-mode="Ignore">
                <ui:Label text="FREE CAM" class="freecam-title" />
                <ui:Label name="freecam-mode-label" text="ALL PLAYERS: AI" class="freecam-subtitle" />
            </ui:VisualElement>
            <ui:VisualElement class="help-card freecam-help-card glass-card" picking-mode="Ignore">
                <ui:VisualElement class="help-heading" picking-mode="Ignore">
                    <ui:VisualElement picking-mode="Ignore">
                        <ui:Label text="SPECTATOR CAMERA" class="eyebrow" />
                        <ui:Label text="自由視角" class="help-title" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:VisualElement class="key-group"><ui:Label text="MOUSE" class="keycap keycap-wide" /></ui:VisualElement><ui:Label text="環繞視角" class="help-action" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:VisualElement class="key-group"><ui:Label text="WASD" class="keycap keycap-wide" /></ui:VisualElement><ui:Label text="自由飛行移動" class="help-action" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:VisualElement class="key-group"><ui:Label text="Q" class="keycap" /><ui:Label text="/" class="key-plus" /><ui:Label text="E" class="keycap" /></ui:VisualElement><ui:Label text="下降／上升" class="help-action" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:VisualElement class="key-group"><ui:Label text="SHIFT" class="keycap keycap-wide" /></ui:VisualElement><ui:Label text="加速移動" class="help-action" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:VisualElement class="key-group"><ui:Label text="P" class="keycap keycap-single" /></ui:VisualElement><ui:Label text="返回球員攝影機" class="help-action" /></ui:VisualElement>
                <ui:VisualElement class="help-row"><ui:VisualElement class="key-group"><ui:Label text="ESC" class="keycap keycap-wide" /></ui:VisualElement><ui:Label text="釋放／鎖定滑鼠" class="help-action" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
