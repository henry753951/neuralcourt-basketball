/* Courtside Capture — KISS dark desktop UI */

:root {
    --app-bg: #0c0c0d;
    --window-bg: #151516;
    --sidebar-bg: #171718;
    --surface: #1c1c1e;
    --surface-hover: #262628;
    --field-bg: #232325;

    --border: #2d2d30;
    --border-strong: #3a3a3e;

    --text-primary: #f2f2f4;
    --text-secondary: #c6c6ca;
    --text-muted: #96969c;

    --blue: #0a84ff;
    --blue-hover: #3296ff;
    --blue-pressed: #0067d9;
    --red: #ff4f45;

    --radius-sm: 7px;
    --radius-md: 11px;
    --radius-lg: 14px;
    --transition-fast: 120ms;
}

.panel-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 8px;
    background-color: var(--app-bg);
    color: var(--text-primary);
}

.app-window {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    flex-direction: column;
    background-color: var(--window-bg);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius-lg);
}

.top-bar,
.top-bar-actions,
.capture-toolbar,
.preview-header,
.global-controls,
.control-group,
.button-row,
.button-row-settings,
.field-row {
    flex-direction: row;
    align-items: center;
}

.top-bar {
    height: 48px;
    flex-shrink: 0;
    justify-content: flex-start;
    padding-left: 16px;
    padding-right: 10px;
    background-color: var(--sidebar-bg);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.app-title {
    color: var(--text-primary);
    font-size: 14px;
    -unity-font-style: bold;
}

.top-bar-actions {
    margin-left: auto;
    flex-shrink: 0;
}

.header-tabs {
    flex-direction: row;
    margin-left: 14px;
}

.header-tab {
    min-height: 30px;
    margin-right: 7px;
    color: var(--text-secondary);
    background-color: #242427;
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius-sm);
}

.header-tab:hover {
    color: var(--text-primary);
    background-color: #2c2c30;
}

.header-tab.selected {
    color: #ffffff;
    -unity-font-style: bold;
    background-color: var(--blue);
    border-color: var(--blue);
}

.status-text {
    margin-right: 12px;
    color: var(--text-secondary);
    font-size: 10px;
}

.status-text.error {
    color: var(--red);
}

.close-button {
    width: 28px;
    height: 28px;
    min-width: 28px;
    padding: 0;
    margin: 0;
    color: var(--text-secondary);
    font-size: 17px;
    background-color: #232325;
    border-width: 0;
    border-radius: var(--radius-sm);
    transition-property: background-color, color;
    transition-duration: var(--transition-fast);
}

.close-button:hover {
    color: var(--text-primary);
    background-color: #303033;
}

.workspace {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: row;
}

.side-menu {
    width: 190px;
    flex-shrink: 0;
    min-height: 0;
    padding: 16px 10px 10px 10px;
    flex-direction: column;
    background-color: var(--sidebar-bg);
    border-right-width: 1px;
    border-right-color: var(--border);
}

.sidebar-title {
    margin-left: 8px;
    margin-bottom: 10px;
    color: var(--text-primary);
    font-size: 12px;
    -unity-font-style: bold;
}

.camera-list {
    flex-grow: 1;
    min-height: 0;
}

.camera-row {
    margin-bottom: 3px;
}

.camera-select {
    min-height: 36px;
    padding-left: 10px;
    padding-right: 10px;
    color: var(--text-secondary);
    font-size: 11px;
    -unity-text-align: middle-left;
    white-space: normal;
    background-color: transparent;
    border-width: 0;
    border-radius: var(--radius-sm);
    transition-property: background-color, color;
    transition-duration: var(--transition-fast);
}

.camera-select:hover {
    color: var(--text-primary);
    background-color: var(--surface-hover);
}

.camera-select.selected {
    color: var(--text-primary);
    -unity-font-style: bold;
    background-color: #2b2b2e;
}

.camera-row .unity-toggle {
    width: auto;
    min-width: 0;
    min-height: 24px;

    margin-top: 4px;
    margin-right: 8px;
    margin-bottom: 8px;
    margin-left: 10px;

    padding: 0;

    flex-direction: row;
    align-items: center;
    justify-content: flex-start;

    flex-grow: 0;
    flex-shrink: 0;
}

.camera-row .unity-toggle__label {
    width: auto;
    min-width: 0;

    margin: 0 7px 0 0;

    color: var(--text-secondary);
    font-size: 10px;

    flex-grow: 0;
    flex-shrink: 0;

    -unity-text-align: middle-left;
}

.camera-row .unity-toggle__input {
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    max-width: 16px;
    max-height: 16px;

    margin: 0;
    padding: 0;

    flex-grow: 0;
    flex-shrink: 0;

    align-items: center;
    justify-content: center;
}

.camera-row .unity-toggle__checkmark {
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;

    margin: 0;

    background-color: var(--field-bg);
    border-width: 1px;
    border-color: var(--border-strong);
    border-radius: 4px;

    -unity-background-image-tint-color: #ffffff;
}

.camera-row .unity-toggle:hover .unity-toggle__checkmark {
    border-color: #5b5b61;
}

.camera-row .unity-toggle:checked .unity-toggle__checkmark {
    background-color: var(--blue);
    border-color: var(--blue);
}

.capture-workspace {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    background-color: var(--window-bg);
}

.render-page {
    flex-grow: 1;
    min-height: 0;
    padding: 12px;
}

.capture-toolbar {
    height: 50px;
    flex-shrink: 0;
    justify-content: space-between;
    padding-left: 16px;
    padding-right: 16px;
}

.page-title {
    color: var(--text-primary);
    font-size: 16px;
    -unity-font-style: bold;
}

.selected-camera {
    max-width: 300px;
    color: var(--text-secondary);
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
}

.capture-body {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    flex-direction: row;
    padding: 0 12px 12px 12px;
}

.preview-column {
    flex-grow: 1;
    min-width: 340px;
    min-height: 0;
    padding-right: 12px;
}

.preview-card {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    flex-direction: column;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius-md);
}

.preview-header {
    height: 38px;
    flex-shrink: 0;
    padding-left: 13px;
    padding-right: 13px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.section-title {
    color: var(--text-primary);
    font-size: 11px;
    -unity-font-style: bold;
}

.preview-stage {
    flex-grow: 1;
    min-height: 180px;
    margin: 8px;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    background-color: #000000;
    border-radius: var(--radius-sm);
}

.preview {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-height: 160px;
    background-color: #000000;
}

.settings-pane {
    width: 326px;
    flex-shrink: 0;
    min-height: 0;
    background-color: transparent;
}

.inspector-title {
    margin: 2px 2px 10px 2px;
    color: var(--text-primary);
    font-size: 12px;
    -unity-font-style: bold;
}

.settings-tabs {
    flex-direction: row;
    margin: 0 2px 10px 2px;
}

.tab-button {
    min-height: 30px;
    margin-right: 6px;
    color: var(--text-secondary);
    background-color: #242427;
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius-sm);
}

.tab-button:hover {
    color: var(--text-primary);
    background-color: #2c2c30;
}

.tab-button.selected {
    color: #ffffff;
    -unity-font-style: bold;
    background-color: var(--blue);
    border-color: var(--blue);
}

.settings-card {
    margin-bottom: 10px;
    padding: 13px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius-md);
}

.settings-title {
    margin-bottom: 11px;
    color: var(--text-primary);
    font-size: 11px;
    -unity-font-style: bold;
}

.field-row {
    width: 100%;
    align-items: flex-start;
    margin-bottom: 8px;
}

.compact-field,
.axis-field {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    max-width: 100%;
    min-height: 47px;
    margin: 0;
    flex-direction: column;
    align-items: stretch;
}

.gap-right {
    margin-right: 10px;
}

.field-caption {
    margin-top: 4px;
    margin-bottom: 6px;
    color: var(--text-secondary);
    font-size: 10px;
    -unity-font-style: bold;
}

.compact-field .unity-base-field__label,
.axis-field .unity-base-field__label {
    min-width: 0;
    max-width: none;
    margin-bottom: 4px;
    color: var(--text-secondary);
    font-size: 9px;
    -unity-text-align: middle-left;
}

.compact-field .unity-base-text-field__input,
.compact-field .unity-float-field__input,
.compact-field .unity-integer-field__input,
.compact-field .unity-base-popup-field__input,
.axis-field .unity-base-text-field__input,
.axis-field .unity-float-field__input,
.axis-field .unity-integer-field__input {
    width: 100%;
    max-width: 100%;
    min-height: 30px;
    padding-left: 9px;
    padding-right: 9px;
    color: var(--text-primary);
    font-size: 11px;
    background-color: var(--field-bg);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius-sm);
    transition-property: background-color, border-color;
    transition-duration: var(--transition-fast);
}

.compact-field .unity-base-popup-field__input {
    min-height: 36px;
    padding-top: 8px;
    padding-bottom: 8px;
    -unity-text-align: middle-left;
    overflow: visible;
}


.compact-field .unity-base-text-field__input:hover,
.compact-field .unity-float-field__input:hover,
.compact-field .unity-integer-field__input:hover,
.compact-field .unity-base-popup-field__input:hover,
.axis-field .unity-base-text-field__input:hover,
.axis-field .unity-float-field__input:hover,
.axis-field .unity-integer-field__input:hover {
    background-color: #2a2a2d;
    border-color: var(--border-strong);
}

.compact-field .unity-base-text-field__input:focus,
.compact-field .unity-float-field__input:focus,
.compact-field .unity-integer-field__input:focus,
.compact-field .unity-base-popup-field__input:focus,
.axis-field .unity-base-text-field__input:focus,
.axis-field .unity-float-field__input:focus,
.axis-field .unity-integer-field__input:focus {
    background-color: #2a2a2d;
    border-color: var(--blue);
}

.compact-field .unity-popup-field__text {
    flex-grow: 1;
    min-width: 0;
    max-width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--text-primary);
    font-size: 11px;
    -unity-text-align: middle-left;
    line-height: 1.2;
}

.compact-field .unity-base-popup-field__arrow {
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--text-secondary);
}

.button-row,
.button-row-settings {
    flex-wrap: nowrap;
}

.button-row.wrap,
.button-row-settings.wrap {
    flex-wrap: wrap;
}

.button-row-settings {
    margin-top: 9px;
}

.button-row > *,
.button-row-settings > * {
    margin-right: 7px;
}

.unity-button {
    min-height: 30px;
    padding-left: 11px;
    padding-right: 11px;
    color: var(--text-primary);
    font-size: 10px;
    background-color: #2e2e31;
    border-width: 1px;
    border-color: #36363a;
    border-radius: var(--radius-sm);
    transition-property: background-color, border-color, color, scale;
    transition-duration: var(--transition-fast);
}

.unity-button:hover {
    background-color: #39393d;
    border-color: #45454a;
}

.unity-button:active {
    scale: 0.98 0.98;
}

.unity-button.primary {
    color: #ffffff;
    -unity-font-style: bold;
    background-color: var(--blue);
    border-color: var(--blue);
}

.unity-button.primary:hover {
    background-color: var(--blue-hover);
    border-color: var(--blue-hover);
}

.unity-button.primary:active {
    background-color: var(--blue-pressed);
    border-color: var(--blue-pressed);
}

.unity-button.quiet {
    color: var(--text-secondary);
    background-color: transparent;
    border-color: transparent;
}

.unity-button.quiet:hover {
    color: var(--text-primary);
    background-color: var(--surface-hover);
    border-color: transparent;
}

.unity-button.danger-quiet {
    color: var(--red);
    background-color: transparent;
    border-color: transparent;
}

.unity-button.danger-quiet:hover {
    color: #ffffff;
    background-color: var(--red);
    border-color: var(--red);
}

.global-controls {
    min-height: 60px;
    flex-shrink: 0;
    padding-left: 14px;
    padding-right: 14px;
    background-color: var(--sidebar-bg);
    border-top-width: 1px;
    border-top-color: var(--border);
}

.control-group {
    flex-shrink: 0;
    margin-right: 22px;
}

.control-label {
    flex-shrink: 0;
    margin-right: 9px;
    color: var(--text-secondary);
    font-size: 10px;
    -unity-font-style: bold;
}

.ball-group {
    min-width: 280px;
}

.data-group {
    min-width: 330px;
}

.seed-field {
    width: 108px;
    min-height: 30px;
    margin: 0 7px 0 0;
    flex-direction: row;
    align-items: center;
}

.seed-field .unity-base-field__label {
    min-width: 32px;
    max-width: 32px;
    margin-right: 6px;
    margin-bottom: 0;
    color: var(--text-secondary);
    font-size: 9px;
}

.seed-field .unity-integer-field__input {
    min-height: 30px;
    padding-left: 8px;
    padding-right: 8px;
    color: var(--text-primary);
    font-size: 10px;
    background-color: var(--field-bg);
    border-width: 1px;
    border-color: var(--border);
    border-radius: var(--radius-sm);
}

.frustum-option {
    min-height: 30px;
    margin-left: 2px;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
}

.frustum-label {
    margin-left: 7px;
    color: var(--text-secondary);
    font-size: 10px;
    -unity-text-align: middle-left;
}

.compact-check {
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    margin: 0;
    padding: 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.compact-check .unity-toggle__input {
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    margin: 0;
    padding: 0;
    flex-grow: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.compact-check .unity-toggle__checkmark {
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    margin: 0;
    background-color: var(--field-bg);
    border-width: 1px;
    border-color: var(--border-strong);
    border-radius: 4px;
    -unity-background-image-tint-color: #ffffff;
    transition-property: background-color, border-color;
    transition-duration: var(--transition-fast);
}

.compact-check:hover .unity-toggle__checkmark {
    border-color: #5b5b61;
}

.compact-check:checked .unity-toggle__checkmark {
    background-color: var(--blue);
    border-color: var(--blue);
}

.unity-scroller {
    width: 8px;
}

.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

.unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
}

.unity-base-slider__dragger {
    width: 5px;
    min-width: 5px;
    background-color: rgba(198, 198, 202, 0.36);
    border-width: 0;
    border-radius: 3px;
}

.unity-base-slider__dragger:hover {
    background-color: rgba(198, 198, 202, 0.62);
}

@media (max-width: 1400px) {
    .side-menu {
        width: 176px;
    }

    .settings-pane {
        width: 304px;
    }

    .control-group {
        margin-right: 14px;
    }

    .control-label {
        display: none;
    }

    .ball-group {
        min-width: 250px;
    }

    .data-group {
        min-width: 292px;
    }
}

@media (max-width: 1120px) {
    .side-menu {
        width: 164px;
    }

    .settings-pane {
        width: 282px;
    }

    .capture-body {
        padding-left: 8px;
        padding-right: 8px;
        padding-bottom: 8px;
    }

    .preview-column {
        padding-right: 8px;
    }

    .global-controls {
        min-height: 58px;
        padding-left: 10px;
        padding-right: 10px;
    }

    .control-group {
        margin-right: 9px;
    }

    .ball-group {
        min-width: 228px;
    }

    .data-group {
        min-width: 270px;
    }
}
